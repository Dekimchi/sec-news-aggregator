[Unit]
Description=Run unattended security upgrades for sec-news host
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
# Refresh indexes first — apt-daily may be masked on hardened VPS images.
ExecStartPre=/usr/bin/apt-get update -qq
ExecStart=/usr/bin/unattended-upgrade -v
