# No-domain mode: HTTP + HTTPS with local/self-signed cert (browser warning is expected).
# When you get a domain later, replace this file contents with a hostname block
# and set SITE_ADDRESS=your.domain in setup-proxy.sh / CD.

:80 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy 127.0.0.1:8000
	log {
		output file /var/log/caddy/sec-news-access.log
		format console
	}
}

:443 {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy 127.0.0.1:8000
	log {
		output file /var/log/caddy/sec-news-access.log
		format console
	}
}
