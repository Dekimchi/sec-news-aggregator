APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET=change-me
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me
DATABASE_PATH=./data/sec_news.db
# RSS ingest interval (APScheduler inside sec-news process)
FETCH_INTERVAL_HOURS=4
TRANSLATE_ENABLED=true
TRANSLATE_PROVIDER=mymemory
MYMEMORY_EMAIL=
TRANSLATE_MAX_CHARS=400
HIDE_LEGISLATION_BY_DEFAULT=true
RETENTION_DAYS=7

# Telegram (optional): alerts for hot articles + daily digest
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_ALERT_MIN_SCORE=75
TELEGRAM_DIGEST_ENABLED=true
# Daily digest cron hour in UTC (6 UTC ≈ 09:05 Europe/Moscow)
TELEGRAM_DIGEST_HOUR_UTC=6

# Briefs for hot articles
BRIEF_ENABLED=true
BRIEF_MAX_CHARS=280
BRIEF_MIN_SCORE=55
BRIEF_MAX_PER_INGEST=8
